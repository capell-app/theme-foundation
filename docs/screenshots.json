            "required": true,
            "user": false,
            "notes": "Runner-only proof of the real Foundation logo, shared header navigation, published homepage composition, and shared footer; separate from Core Default Theme base-palette evidence.",
            "useCase": "A maintainer verifies the complete Foundation public chrome and published homepage at desktop size in both supported colour modes.",
            "evidenceScope": "foundation-real-chrome",
            "package": "theme-foundation",
            "scenario": "frontend-page",
            "waitFor": "body:has(#header .header-logo):has(#header nav):has(#main):has(#footer)",
            "colorSchemes": ["light", "dark"],
            "viewport": "desktop",
            "fullPage": true,
            "assertions": [
                { "type": "visible", "selector": "#header nav" },
                {
                    "type": "no-horizontal-overflow",
                    "selector": "html",
                    "tolerance": 1
                },
                {
                    "type": "no-horizontal-overflow",
                    "selector": "#header",
                    "tolerance": 1
                }
            ]
        },
