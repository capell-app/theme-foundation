{
    "name": "capell-app/theme-foundation",
    "description": "Pale green starter theme for Capell sites, with a dark colour set and the retired-theme migration command.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.66",
        "capell-app/core": "^1.0.79",
        "capell-app/frontend": "^1.0.79",
        "capell-app/layout-builder": "^1.0",
        "capell-app/navigation": "^1.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-package-tools": "^1.0"
    },
    "conflict": {
        "capell-app/theme-bistro": "<=1.0.20",
        "capell-app/theme-business": "<=1.0.55",
        "capell-app/theme-paperdesk": "<=1.0.21"
    },
    "suggest": {
        "capell-app/search": "Follows the public search switch and results path when Search is installed."
    },
    "autoload": {
        "psr-4": {
            "Capell\\FoundationTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\FoundationTheme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\FoundationTheme\\Providers\\FoundationThemeServiceProvider",
                "Capell\\FoundationTheme\\Providers\\FoundationThemeSiteSpecServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "homepage": "https://github.com/capell-app/theme-foundation",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "theme",
        "frontend"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/theme-foundation"
    }
}
