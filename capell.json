{
    "manifest-version": 3,
    "name": "capell-app/theme-foundation",
    "slug": "theme-foundation",
    "displayName": "Foundation Theme",
    "kind": "theme",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Pale green theme for documentation and general publishing sites that developers can build on, with a dark version and a command for retired themes.",
    "product": {
        "group": "Capell Themes",
        "tier": "free",
        "bundle": "themes"
    },
    "namespace": "Capell\\FoundationTheme",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder",
            "capell-app/navigation"
        ],
        "supports": ["capell-app/search"],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\FoundationTheme\\Providers\\FoundationThemeServiceProvider"
        ],
        "install": [
            "Capell\\FoundationTheme\\Providers\\ConsoleServiceProvider"
        ],
        "runtime": [
            "Capell\\FoundationTheme\\Providers\\FoundationThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "public-render-data",
            "key": "foundation_image_loading",
            "class": "Capell\\FoundationTheme\\Support\\Render\\FoundationImageLoadingContributor"
        },
        {
            "type": "console-command",
            "class": "Capell\\FoundationTheme\\Manifest\\FoundationThemeConsoleCommandsContribution",
            "commands": [
                "capell:frontend-tailwind-assets",
                "capell:make-foundation-theme",
                "capell:theme-catalogue-report",
                "capell:theme-foundation-demo",
                "capell:theme-foundation-setup",
                "capell:theme-migrate",
                "capell:validate-themes"
            ],
            "commandClasses": [
                "Capell\\FoundationTheme\\Console\\Commands\\GenerateTailwindAssetsCommand",
                "Capell\\FoundationTheme\\Console\\Commands\\MakeFoundationThemeCommand",
                "Capell\\FoundationTheme\\Console\\Commands\\ThemeCatalogueReportCommand",
                "Capell\\FoundationTheme\\Console\\Commands\\DemoCommand",
                "Capell\\FoundationTheme\\Console\\Commands\\SetupCommand",
                "Capell\\FoundationTheme\\Console\\Commands\\MigrateThemeCommand",
                "Capell\\FoundationTheme\\Console\\Commands\\ValidateThemesCommand"
            ]
        }
    ],
    "database": {
        "migrations": false,
        "settings": true,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": "capell:theme-foundation-setup",
        "demo": "capell:theme-foundation-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null,
        "tailwindAssets": "capell:frontend-tailwind-assets",
        "catalogueReport": "capell:theme-catalogue-report",
        "makeTheme": "capell:make-foundation-theme",
        "migrateTheme": "capell:theme-migrate",
        "validateThemes": "capell:validate-themes"
    },
    "actions": {
        "setup": "Capell\\FoundationTheme\\Actions\\SetupFoundationThemePackageAction",
        "demo": "Capell\\FoundationTheme\\Actions\\InstallFoundationThemeDemoAction"
    },
    "settings": ["Capell\\FoundationTheme\\Settings\\FoundationThemeSettings"],
    "permissions": [],
    "capabilities": [
        "frontend-assets",
        "cache-blocking",
        "design-spec-v1",
        "deterministic-theme-compiler",
        "project-build-capell-theme-artifact"
    ],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [
                "GET /_capell/foundation-dynamic-form/{reference} (capell-theme-foundation.dynamic-form-fragments.show)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\FoundationTheme\\Actions\\DesignSpec\\CompileFoundationThemeArtifactAction"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["theme-foundation"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-foundation.package-health",
            "label": "Foundation Theme package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\FoundationTheme\\Health\\FoundationThemeHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "A header that stays in view, ready-made page sections and a settings page for colours and spacing.",
        "description": "A plain starting theme for documentation and general publishing sites, with a very pale green-grey page, near-black text and deep green-teal links. A dark version switches on from a header button and not from the device setting. Other Capell themes are built on it and install it with them, and developers use its command to move sites off retired themes. Its form section needs the Form Builder package.",
        "problem": "I want a plain, tidy theme for a documentation or general site without starting from nothing.",
        "outcome": "Your documentation or general site gets a pale green page, a header that stays put and ready-made sections to build pages from.",
        "faq": [
            {
                "question": "Do I need to install Foundation Theme myself?",
                "answer": "Usually not. Capell's other themes are built on it and install it along with themselves. You can also use it on its own as a plain starting theme."
            },
            {
                "question": "Does Foundation Theme have a dark version?",
                "answer": "Yes. Visitors press the dark button in the header to switch. It does not follow the device's own dark setting, and the browser remembers the choice for later visits."
            },
            {
                "question": "Can the form section work without Form Builder?",
                "answer": "No. The form section depends on the Form Builder package. The hero and call to action sections do not."
            },
            {
                "question": "Can it move my sites off a retired theme?",
                "answer": "Yes. A command previews the move before changing anything and saves a report that can reverse it. Anything that cannot be carried across is left behind."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "A marketplace card titled Foundation Theme with two search page previews and a row of three numbered boxes",
                "caption": "The card shows that other Capell themes build on this one."
            },
            {
                "path": "docs/screenshots/foundation-chrome-homepage.webp",
                "alt": "A consultancy home page with a white header, a green logo, three feature cards, a search box, note cards and a dark band",
                "caption": "The default look pairs a pale page with deep green-teal buttons and labels."
            },
            {
                "path": "docs/screenshots/foundation-directory.webp",
                "alt": "A page of field notes with a search box and a three-card grid of notes with photos, then a dark call to action",
                "caption": "A content list shows notes as cards, newest first."
            },
            {
                "path": "docs/screenshots/foundation-detail.webp",
                "alt": "A single article page with a headline beside a photo, three feature cards and an enquiry form",
                "caption": "A page built from ready-made sections, here a hero, features and a form."
            },
            {
                "path": "docs/screenshots/foundation-contact.webp",
                "alt": "An enquiry page with a hero, an empty form for name, email and message, three feature cards and a dark call to action",
                "caption": "The form section is where visitors send an enquiry."
            },
            {
                "path": "docs/screenshots/foundation-empty.webp",
                "alt": "A search results page saying no notes match the search night shifts, with the search box and a dark call to action",
                "caption": "This is what visitors see when a search finds nothing, with ways to carry on."
            },
            {
                "path": "docs/screenshots/foundation-not-found.webp",
                "alt": "A page not found message with a link home, a short list of suggested links and a pale green footer",
                "caption": "A missing page points visitors back to useful places on the site."
            },
            {
                "path": "docs/screenshots/foundation-cta.webp",
                "alt": "A start-a-project page with a hero, three feature cards, an empty enquiry form and a dark call to action band",
                "caption": "A dark band asks visitors to browse or search once they have read the page."
            }
        ],
        "categories": ["admin", "foundation", "frontend"]
    },
    "extends": null,
    "themeKey": "default",
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.navigation",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.hero",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.features",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.proof",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.content-listing",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.search",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.pagination",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.form",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.contact-split",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.cta",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.foundation.footer",
                "providerBucket": "runtime"
            },
            {
                "type": "asset",
                "key": "frontend-asset:Page",
                "providerBucket": "runtime"
            },
            {
                "type": "model",
                "key": "model-interceptor:Capell\\Core\\Models\\Theme:Capell\\FoundationTheme\\Support\\Interceptors\\Themes\\FoundationThemeInterceptor:default",
                "providerBucket": "runtime"
            },
            {
                "type": "setting",
                "key": "settings-class:theme_foundation",
                "providerBucket": "runtime"
            },
            {
                "type": "setting",
                "key": "settings-schema:theme_foundation:FoundationThemeSettingsSchema",
                "providerBucket": "runtime"
            },
            {
                "type": "admin-page",
                "key": "extension-management-surface:capell-app/theme-foundation:settings:theme_foundation",
                "providerBucket": "runtime"
            },
            {
                "type": "public-render-data",
                "key": "foundation_image_loading",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "capell-app.auth-menu",
                "providerBucket": "runtime"
            }
        ]
    },
    "roles": ["default-theme"]
}
